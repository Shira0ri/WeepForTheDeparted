Mods: {
	WeepForTheDeparted: {
		Items: {
			Naught: {
				DisplayName: Naught
				Tooltip:
					'''
					Acheron's blade from the boundless depths of Nihility.
					Its power grows with every great soul laid to rest.
					'''
			}
		}

		Configs: {
			WeepConfig: {
				DisplayName: Weep for the Departed Config

				Headers: {
					WeaponScaling: Weapon Scaling Settings
					BossTracking: Boss Tracking Settings
				}

				BaseSwordDamage: {
					Label: Base Sword Damage
					Tooltip: Base damage of Naught before any defeated bosses.
				}

				DamagePerBoss: {
					Label: Bonus Damage Per Boss
					Tooltip: Flat base damage added to Naught for each defeated boss.
				}

				CritPerBoss: {
					Label: Bonus Crit Per Boss (%)
					Tooltip: Additional critical strike chance added to Naught per defeated boss.
				}

				UniversalBossScaling: {
					Label: Universal Boss Scaling
					Tooltip: When enabled, all non-vanilla modded bosses defeated will be tracked and counted.
				}

				IncludeCalamityBosses: {
					Label: Include Calamity Bosses
					Tooltip: When enabled, bosses from the Calamity Mod are counted toward progression scaling.
				}
			}
		}
	}
}

