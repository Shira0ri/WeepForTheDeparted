Buffs: {
	RainleafCooldownBuff: {
		DisplayName: Rainleaf Cooldown
		Description: Void Phasing is recovering and cannot trigger again yet.
	}

	StillWaterFocusBuff: {
		DisplayName: Still Water
		Description: Unbroken poise sharpens Naught's edge (+15% True Melee Crit Chance and +15% Vanilla / +18% Calamity Crit Damage).
	}

	AbyssGripDebuff: {
		DisplayName: Grip of the Abyss
		Description: Ensnared by the abyss; True Melee damage taken is increased per unique debuff.
	}

	WitheredRiverDebuff: {
		DisplayName: Withered River
		Description: Corrosion of the dried Lethe peels enemy Damage Reduction (14% Vanilla / 10% Calamity, converted to bonus damage on 0% DR targets).
	}

	ShadowCrucibleDebuff: {
		DisplayName: Shadow Crucible
		Description: Trapped in Nihility's furnace; DoT damage is amplified inside clone zones and stored for cycle-expiry detonation.
	}

	SiphonHasteBuff: {
		DisplayName: Siphon of the Departed
		Description: Crimson vitality surges through your steps (+15% movement speed and acceleration).
	}

	EmancipatorWillBuff: {
		DisplayName: Severed Will
		Description: Post-Ultimate surge grants bonus True Melee Crit Chance (+15% Vanilla / +20% Calamity) to Naught and its echoes.
	}
}
