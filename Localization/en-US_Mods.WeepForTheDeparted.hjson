Items: {
	Naught: {
		DisplayName: Naught
		Tooltip:
			'''
			Acheron's blade from the boundless depths of Nihility.
			Its power grows with every great soul laid to rest.
			'''
	}

	NihilityDebugItem: {
		DisplayName: Nihility Debug Item
		Tooltip: ""
	}
}

Configs: {
	WeepConfig: {
		DisplayName: Weep for the Departed Config

		Headers: {
			WeaponScaling: Weapon Scaling Settings
			BossTracking: Boss Tracking Settings
			GameplayBalance: Gameplay Balance Settings
		}

		OverrideWeaponScaling: {
			Label: Override Weapon Scaling
			Tooltip: When disabled (default), Balance Mode controls Naught's base damage, per-boss damage/crit scaling, and Calamity stage multipliers. Enable to use the manual sliders below.
		}

		BaseSwordDamage: {
			Label: Base Sword Damage
			Tooltip: Manual base damage of Naught before any defeated bosses (used when Override Weapon Scaling is enabled).
		}

		DamagePerBoss: {
			Label: Bonus Damage Per Boss
			Tooltip: Manual flat base damage added to Naught for each defeated boss (used when Override Weapon Scaling is enabled).
		}

		CritPerBoss: {
			Label: Bonus Crit Per Boss (%)
			Tooltip: Manual critical strike chance added to Naught per defeated boss (used when Override Weapon Scaling is enabled).
		}

		UniversalBossScaling: {
			Label: Universal Boss Scaling
			Tooltip: When enabled, all non-vanilla modded bosses defeated will be tracked and counted.
		}

		IncludeCalamityBosses: {
			Label: Include Calamity Bosses
			Tooltip: When enabled, bosses from the Calamity Mod are counted toward progression scaling.
		}

		BalanceMode: {
			Label: Balance Mode
			Tooltip: Controls the unified Vanilla/Calamity Balance Profile (weapon scaling, basekit combat, all 18 Nihility Charms, and Eidolons E1-EX). Auto detects Calamity Mod.
		}

		UnlockAllInscriptionsAndEidolons: {
			Label: Unlock All Inscriptions & Eidolons (Sandbox)
			Tooltip: When enabled, bypasses boss progression locks for all 18 Nihility Charms and 7 Eidolons (E1-EX). Ideal for testing or sandbox runs.
		}
	}

	WeepBalanceMode: {
		Tooltip: ""

		Auto: {
			Label: Auto (Detect Calamity)
			Tooltip: Automatically selects Calamity balance when Calamity Mod is loaded, and Vanilla balance otherwise.
		}

		Calamity: {
			Label: Calamity
			Tooltip: Forces the Calamity-tuned balance profile (including Post-Moon Lord stage multipliers).
		}

		Vanilla: {
			Label: Vanilla
			Tooltip: Forces the Vanilla Terraria-tuned balance profile.
		}
	}
}

